# Copy to .env for local `eas` commands. Never commit .env.
# In CI these are GitHub repository secrets (Settings > Secrets and variables > Actions).

# expo.dev > Account settings > Access tokens
EXPO_TOKEN=dummy-expo-access-token

# Full JSON content of the Google Play service account key (CI writes it to secrets/google-service-account.json)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"dummy"}
